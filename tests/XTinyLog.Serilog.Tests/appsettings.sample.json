{
  "Serilog": {
    "Using": [ "XTinyLog.Serilog" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "XTinyLog",
        "Args": {
          "logDirectory": "c:\\MyAppLogs",
          "applicationName": "MyApplication",
          "maxFileSize": 2048,
          "includeProperties": true,
          "propertyFormat": "Inline"
        }
      },
      {
        "Name": "XTinyLogAsync",
        "Args": {
          "logDirectory": "c:\\MyAppAsyncLogs",
          "applicationName": "MyAsyncApplication",
          "maxFileSize": 4096,
          "includeProperties": false,
          "propertyFormat": "Structured"
        }
      }
    ]
  }
}