{
  "Serilog": {
    "Using": [ "XTinyLog.Serilog" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "XTinyLog",
        "Args": {
          "logDirectory": "C:\\Logs\\MyApplication",
          "applicationName": "MyApp",
          "maxFileSize": 5120,
          "includeProperties": true,
          "propertyFormat": "Structured"
        }
      },
      {
        "Name": "XTinyLogAsync",
        "Args": {
          "logDirectory": "C:\\Logs\\MyApplicationAsync",
          "applicationName": "MyAppAsync",
          "maxFileSize": 10240,
          "includeProperties": true,
          "propertyFormat": "Inline"
        }
      }
    ]
  }
}