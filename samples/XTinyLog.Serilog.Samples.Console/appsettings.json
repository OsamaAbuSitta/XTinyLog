{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "XTinyLog",
        "Args": {
          "logDirectory": "Logs/Configuration",
          "applicationName": "ConfigurationSample",
          "maxFileSize": 1024,
          "includeProperties": true,
          "propertyFormat": "Structured"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}